alias py='python'

alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'

alias la='ls -A'
alias ll='ls -lhA'
alias ..='cd ..'

alias em='emacs'

alias c='clear'
alias h='history'

alias op='termux-open'
alias btw='echo i use termux btw'
alias re='termux-reload-settings'

alias dots='cd $HOME/termux-dotfiles'

export EDITOR=emacs
export VISUAL=emacs
